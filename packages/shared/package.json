{
  "name": "@club/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./seeds": {
      "types": "./dist/seeds.d.ts",
      "import": "./dist/seeds.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run"
  },
  "files": ["dist/**/*.js", "dist/**/*.d.ts", "!dist/**/*.test.*"],
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^5.0.2",
    "@types/node": "^24.19.0"
  }
}
