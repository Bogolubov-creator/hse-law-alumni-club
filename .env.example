# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=club
POSTGRES_USER=club
POSTGRES_PASSWORD=__СГЕНЕРИРУЙТЕ__  # openssl rand -hex 24

# ─── Directus ─────────────────────────────────────────────────
# KEY/SECRET — любые длинные случайные строки (openssl rand -hex 32)
DIRECTUS_KEY=replace_with_random_key
DIRECTUS_SECRET=replace_with_random_secret
# ВАЖНО: используйте валидный домен (Directus отклоняет .local в e-mail)
ADMIN_EMAIL=admin@club.example.com
ADMIN_PASSWORD=__СГЕНЕРИРУЙТЕ__  # сильный пароль, не деплоить дефолт
# Локально: http://localhost:8055 · На VPS: https://admin.<домен>
DIRECTUS_PUBLIC_URL=http://localhost:8055
# Статический токен для apps/api (openssl rand -hex 24). Создаётся bootstrap'ом.
DIRECTUS_SERVICE_TOKEN=replace_with_service_token

# ─── apps/api ─────────────────────────────────────────────────
API_PORT=3000
DIRECTUS_URL=http://directus:8055
# Прод-флаг: APP_ENV=production включает fail-fast – старт ПРЕРЫВАЕТСЯ, если:
#   • AUTH_SECRET или DIRECTUS_SERVICE_TOKEN выглядят как плейсхолдер;
#   • не задан ADMIN_AUTH_SECRET;
#   • PUBLIC_URL не начинается с https://;
#   • бот на webhook без TELEGRAM_WEBHOOK_SECRET;
#   • пуст SMTP_HOST (без почты ломаются восстановление пароля и подтверждение адреса);
#   • SMTP задан, но нет отправителя (SMTP_FROM или SMTP_USER);
#   • SEED_DEMO=true (демо-контент и тестовые аккаунты на боевом стенде).
# Локально оставляйте development.
APP_ENV=development
# Секрет подписи сессий ЛК (openssl rand -hex 32)
AUTH_SECRET=replace_with_auth_secret
# Отдельный секрет для админ-сессий (опционально, openssl rand -hex 32); пусто = берётся AUTH_SECRET
ADMIN_AUTH_SECRET=
# Токен @pravohse_alumni_bot: mini-app + команды /start /points /calendar
# Демо-данные бутстрапа (тестовый офис/выпускник, демо-контент).
# ЛОКАЛЬНО: SEED_DEMO=true. В ПРОДЕ: SEED_DEMO=false – одним флагом закрываются и
# демо-контент витрин, и тестовые аккаунты (иначе editor со слабым паролем станет
# бэкдором). При APP_ENV=production значение true прерывает старт.
SEED_DEMO=false

TELEGRAM_BOT_TOKEN=
# Секрет webhook (openssl rand -hex 16) — передаётся в setWebhook как secret_token
TELEGRAM_WEBHOOK_SECRET=
# true = long-polling вместо вебхука (локальный стенд без публичного HTTPS)
TELEGRAM_POLLING=
# Username бота без @ (для ссылки «Привязать Telegram» в ЛК)
TELEGRAM_BOT_USERNAME=pravohse_alumni_bot

# Sentry (мониторинг ошибок API): пусто = выключен
SENTRY_DSN=
# Доп. cross-origin источники через запятую (на проде — https://<домен>); same-origin и Telegram разрешены всегда
CORS_ORIGINS=

# ─── Уведомление учебного офиса (решение 3.2) ─────────────────
# telegram | email | both — на старте telegram
OFFICE_NOTIFY_CHANNEL=telegram
OFFICE_TG_BOT_TOKEN=
OFFICE_TG_CHAT_ID=
# ВАЖНО: заданный SMTP_HOST включает подтверждение почты при регистрации — аккаунт
# создаётся неактивным, пока человек не откроет ссылку из письма (иначе можно занять
# чужой адрес и завалить очередь верификации). Без SMTP регистрация работает как раньше.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=club@pravo.hse.ru

# ─── Тестовые аккаунты (сиды, решение «доп. п.2») ─────────────
TEST_EDITOR_EMAIL=editor@club.example.com
TEST_EDITOR_PASSWORD=editor12345
TEST_ALUMNI_EMAIL=alumni@club.example.com
TEST_ALUMNI_PASSWORD=alumni12345

# ─── Caddy / домены (решение «доп. п.3») ──────────────────────
# Локально (без TLS): WEB_DOMAIN=:80  ADMIN_DOMAIN=:8081
# На VPS (auto-TLS):  WEB_DOMAIN=club.example.ru  ADMIN_DOMAIN=admin.club.example.ru
WEB_DOMAIN=:80
ADMIN_DOMAIN=:8081
# ВАЖНО: реальный e-mail оператора; .local Let's Encrypt отклонит (замените перед прод-деплоем).
ACME_EMAIL=admin@club.local

# ── Оплата ЮKassa (yookassa.ru) ──
# Оба ключа заданы = онлайн-оплата включена; пусто = режим «заявка без оплаты».
# Webhook в кабинете ЮKassa: https://<домен>/api/payments/yookassa/webhook
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Публичный адрес сайта (return_url после оплаты, sitemap/robots/canonical).
# ВНИМАНИЕ: web-контейнер инлайнит этот адрес в бандл на СБОРКЕ (VITE_SITE_URL),
# а Studio-URL — из DIRECTUS_PUBLIC_URL (VITE_DIRECTUS_URL). При смене доменов
# web нужно ПЕРЕСОБРАТЬ: docker compose up -d --build web.
PUBLIC_URL=http://localhost

# ── Шифрованные бэкапы БД (scripts/backup-db.sh) ──
# Ключ AES-256 (сгенерировать: openssl rand -hex 32). Хранить отдельно от бэкапов!
BACKUP_ENCRYPTION_KEY=
# Offsite-хранилище бэкапов (152-ФЗ: отдельно от сервера БД, в РФ) — rclone-remote,
# напр. "ydisk:club-backups". Пусто = только локальная копия (на проде — задать!).
BACKUP_OFFSITE_REMOTE=

# CORS для Directus Studio на проде: точный origin вместо 'true' (напр. https://admin.club.ru)
DIRECTUS_CORS_ORIGIN=true

# ── Web-push (уведомления о статусе заявки и анонсы) ──
# Пара VAPID-ключей: npx web-push generate-vapid-keys
# Пусто = пуши выключены целиком, сайт работает без них.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Мониторинг ошибок API (пусто = выключен)
SENTRY_DSN=

# Сроки хранения ПДн (152-ФЗ), дней. По умолчанию заявки 3 года, аудит 1 год.
ORDER_RETENTION_DAYS=1095
AUDIT_RETENTION_DAYS=365
# Потолок запросов с одного IP в минуту. Поднимите, если аудитория сидит за общим
# NAT (университетская сеть): весь корпус приходит с одного адреса. Чувствительные
# операции защищены отдельно – логин 5/мин, регистрация 3/мин, оплата 10/мин.
RATE_LIMIT_MAX=1000
