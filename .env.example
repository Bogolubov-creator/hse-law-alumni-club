# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=club
POSTGRES_USER=club
POSTGRES_PASSWORD=change_me_db

# ─── Directus ─────────────────────────────────────────────────
# KEY/SECRET — любые длинные случайные строки (openssl rand -hex 32)
DIRECTUS_KEY=replace_with_random_key
DIRECTUS_SECRET=replace_with_random_secret
# ВАЖНО: используйте валидный домен (Directus отклоняет .local в e-mail)
ADMIN_EMAIL=admin@club.example.com
ADMIN_PASSWORD=change_me_admin
# Локально: http://localhost:8055 · На VPS: https://admin.<домен>
DIRECTUS_PUBLIC_URL=http://localhost:8055
# Статический токен для apps/api (openssl rand -hex 24). Создаётся bootstrap'ом.
DIRECTUS_SERVICE_TOKEN=replace_with_service_token

# ─── apps/api ─────────────────────────────────────────────────
API_PORT=3000
DIRECTUS_URL=http://directus:8055
# Секрет подписи сессий ЛК (openssl rand -hex 32)
AUTH_SECRET=replace_with_auth_secret

# ─── Уведомление учебного офиса (решение 3.2) ─────────────────
# telegram | email | both — на старте telegram
OFFICE_NOTIFY_CHANNEL=telegram
OFFICE_TG_BOT_TOKEN=
OFFICE_TG_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=club@pravo.hse.ru

# ─── Тестовые аккаунты (сиды, решение «доп. п.2») ─────────────
TEST_EDITOR_EMAIL=editor@club.example.com
TEST_EDITOR_PASSWORD=editor12345
TEST_ALUMNI_EMAIL=alumni@club.example.com
TEST_ALUMNI_PASSWORD=alumni12345

# ─── Caddy / домены (решение «доп. п.3») ──────────────────────
# Локально (без TLS): WEB_DOMAIN=:80  ADMIN_DOMAIN=:8081
# На VPS (auto-TLS):  WEB_DOMAIN=club.example.ru  ADMIN_DOMAIN=admin.club.example.ru
WEB_DOMAIN=:80
ADMIN_DOMAIN=:8081
ACME_EMAIL=admin@club.local
