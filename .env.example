# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=club
POSTGRES_USER=club
POSTGRES_PASSWORD=__СГЕНЕРИРУЙТЕ__  # openssl rand -hex 24

# ─── Первый администратор ────────────────────────────────────
# Bootstrap создаёт отсутствующий аккаунт; существующий пароль не меняет.
ADMIN_EMAIL=admin@club.example.com
ADMIN_PASSWORD=__СГЕНЕРИРУЙТЕ__  # сильный пароль, не деплоить дефолт

# ─── backend ─────────────────────────────────────────────────
API_PORT=3000
# Серверный ключ начисления баллов внешней интеграцией. Пусто – доступ выключен.
POINTS_SERVICE_TOKEN=
# В Docker путь закреплён в compose. Для запуска API вне контейнера укажите свой каталог.
UPLOADS_PATH=/data/uploads
# APP_ENV=production останавливает запуск при следующих ошибках конфигурации:
#   • AUTH_SECRET, ADMIN_AUTH_SECRET или POINTS_SERVICE_TOKEN выглядят как плейсхолдер;
#   • не задан ADMIN_AUTH_SECRET или CHECKOUT_DATABASE_URL;
#   • PUBLIC_URL не начинается с https://;
#   • бот на webhook без TELEGRAM_WEBHOOK_SECRET;
#   • пуст SMTP_HOST (без почты ломаются восстановление пароля и подтверждение адреса);
#   • SMTP задан, но нет отправителя (SMTP_FROM или SMTP_USER);
#   • не настроен выбранный канал уведомлений учебного офиса;
#   • SEED_DEMO=true (демо-контент и тестовые аккаунты в production).
# Локально оставляйте development.
APP_ENV=development
# Секрет подписи сессий ЛК (openssl rand -hex 32)
AUTH_SECRET=replace_with_auth_secret
# Отдельный секрет для админ-сессий (openssl rand -hex 32). Для production обязателен.
# В локальной разработке при пустом значении используется AUTH_SECRET.
ADMIN_AUTH_SECRET=
# Токен @pravohse_alumni_bot: mini-app + команды /start /points /calendar
# Демо-данные бутстрапа (тестовый офис/выпускник, демо-контент).
# SEED_DEMO=true разрешён только для локальных демоданных и тестовых аккаунтов.
# При APP_ENV=production это значение прерывает запуск.
SEED_DEMO=false

TELEGRAM_BOT_TOKEN=
# Секрет webhook (openssl rand -hex 16) – передаётся в setWebhook как secret_token
TELEGRAM_WEBHOOK_SECRET=
# true = long-polling вместо вебхука (локальный стенд без публичного HTTPS)
TELEGRAM_POLLING=
# Username бота без @ (для ссылки «Привязать Telegram» в ЛК)
TELEGRAM_BOT_USERNAME=pravohse_alumni_bot

# Sentry (мониторинг ошибок API): пусто = выключен
SENTRY_DSN=
# Доп. cross-origin источники через запятую (на проде – https://<домен>); same-origin и Telegram разрешены всегда
CORS_ORIGINS=

# ─── Уведомления учебного офиса ─────────────────────────────
# Канал: telegram | email | both
OFFICE_NOTIFY_CHANNEL=telegram
OFFICE_TG_BOT_TOKEN=
OFFICE_TG_CHAT_ID=
# SMTP_HOST включает подтверждение email: аккаунт неактивен до перехода по
# ссылке из письма. В production SMTP обязателен.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Укажите адрес, с которого ваш SMTP-провайдер разрешает отправку.
SMTP_FROM=

# ─── Тестовые аккаунты (сиды, решение «доп. п.2») ─────────────
TEST_EDITOR_EMAIL=editor@club.example.com
TEST_EDITOR_PASSWORD=editor12345
TEST_ALUMNI_EMAIL=alumni@club.example.com
TEST_ALUMNI_PASSWORD=alumni12345

# ─── Caddy / домены (решение «доп. п.3») ──────────────────────
# Локально (без TLS): WEB_DOMAIN=:80  ADMIN_DOMAIN=:8081
# На VPS (auto-TLS):  WEB_DOMAIN=club.example.ru  ADMIN_DOMAIN=admin.club.example.ru
WEB_DOMAIN=:80
ADMIN_DOMAIN=:8081
# ВАЖНО: реальный e-mail оператора; .local Let's Encrypt отклонит (замените перед прод-деплоем).
ACME_EMAIL=admin@club.local

# ── Оплата ЮKassa (yookassa.ru) ──
# Оба ключа заданы = онлайн-оплата включена; пусто = режим «заявка без оплаты».
# Webhook в кабинете ЮKassa: https://<домен>/api/payments/yookassa/webhook
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Публичный адрес сайта (return_url после оплаты, sitemap/robots/canonical).
# ВНИМАНИЕ: web-контейнер инлайнит этот адрес в бандл на СБОРКЕ (VITE_SITE_URL),
# и адрес файлов (VITE_MEDIA_URL). При смене доменов
# web нужно ПЕРЕСОБРАТЬ: docker compose up -d --build web.
PUBLIC_URL=http://localhost

# ── Шифрованные бэкапы БД (scripts/backup.sh) ──
# Ключ AES-256 (сгенерировать: openssl rand -hex 32). Хранить отдельно от бэкапов!
BACKUP_ENCRYPTION_KEY=
# Offsite-хранилище бэкапов (152-ФЗ: отдельно от сервера БД, в РФ) – rclone-remote,
# напр. "ydisk:club-backups". Пусто = только локальная копия (на проде – задать!).
BACKUP_OFFSITE_REMOTE=


# ── Web-push (уведомления о статусе заявки и анонсы) ──
# Пара VAPID-ключей: npx web-push generate-vapid-keys
# Пусто = пуши выключены целиком, сайт работает без них.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Сроки хранения ПДн (152-ФЗ), дней. По умолчанию заявки 3 года, аудит 1 год.
ORDER_RETENTION_DAYS=1095
AUDIT_RETENTION_DAYS=365
# Потолок запросов с одного IP в минуту. Поднимите, если аудитория сидит за общим
# NAT (университетская сеть): весь корпус приходит с одного адреса. Чувствительные
# операции защищены отдельно – логин 5/мин, регистрация 3/мин, оплата 10/мин.
RATE_LIMIT_MAX=1000

# Транзакционный доступ к PostgreSQL. Compose соберёт URL для отдельной роли
# из CHECKOUT_DB_USER/CHECKOUT_DB_PASSWORD; ручной URL требует URL-encoded пароля.
CHECKOUT_DATABASE_URL=
# Получатель уведомлений офиса по email.
OFFICE_EMAIL=

# Поддержка: включение в production только после определения оператора и проверки ПД.
SUPPORT_ENABLED=false
# По умолчанию берётся из packages/shared/src/operator.ts (Rusprofile /id/1257700005551).
SUPPORT_OPERATOR_NAME=Автономная некоммерческая организация «Клуб выпускников факультета права НИУ ВШЭ»
SUPPORT_OPERATOR_ADDRESS=107061, г. Москва, ул. Большая Черкизовская, д. 3, к. 2, помещ. 17/1
SUPPORT_OPERATOR_CONTACT=Письменное обращение по юридическому адресу оператора
# Проектный срок поддержки, согласовать с оператором. Не срок по умолчанию из закона.
SUPPORT_RETENTION_DAYS=30

# Отдельная SQL-роль API создаётся migrate. Пароль: openssl rand -hex 32.
# Храните рабочий env вне репозитория, передавайте через docker compose --env-file.
CHECKOUT_DB_USER=club_api
CHECKOUT_DB_PASSWORD=replace_with_random_hex_password

# Сбор трёх источников каждый час в очередь редактора.
NEWS_SYNC_ENABLED=false
# ID чата с персональными реакциями; канал с анонимными реакциями не подходит.
TELEGRAM_REACTIONS_CHAT_ID=

# Планировщик API. На изолированном стенде false; рабочие задачи сохраняются по умолчанию.
JOBS_ENABLED=true
DPO_SYNC_ENABLED=true
# Хранение полных снимков, дней.
BACKUP_KEEP_DAYS=14
