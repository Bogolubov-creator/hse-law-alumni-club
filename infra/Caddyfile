# Один Caddyfile для локали и VPS — меняются только переменные окружения.
# Локально WEB_DOMAIN=:80 / ADMIN_DOMAIN=:8081 → обычный HTTP (без TLS).
# На VPS WEB_DOMAIN=club.example.ru / ADMIN_DOMAIN=admin.club.example.ru → Caddy сам берёт TLS.
{
	email {$ACME_EMAIL}
	# Периметр против медленных/жадных запросов (Slowloris, гигантские тела).
	servers {
		timeouts {
			read_body 10s
			read_header 5s
			idle 60s
		}
		max_header_size 16kb
	}
}

{$WEB_DOMAIN} {
	encode gzip
	# Тело запроса к API ограничено (доп. к bodyLimit самого API).
	request_body {
		max_size 512kb
	}
	# Ловушка для ботов-сканеров: типовые «дыры» чужих CMS сразу 404,
	# не доходя до приложения (handle-блоки матчатся по порядку — этот первый).
	@bot_probe path /wp-admin* /wp-login.php /.env /.env.* /.git/* /xmlrpc.php /phpmyadmin* /vendor/* /.aws/* /config.php
	handle @bot_probe {
		respond 404
	}
	handle_path /api/* {
		reverse_proxy api:3000
	}
	# Sitemap и robots собирает API (абсолютные URL из PUBLIC_URL)
	handle /sitemap.xml {
		rewrite * /sitemap.xml
		reverse_proxy api:3000
	}
	handle /robots.txt {
		rewrite * /robots.txt
		reverse_proxy api:3000
	}
	handle {
		header {
			Strict-Transport-Security "max-age=15552000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			# Полный CSP: скрипты только свои; стили — свои + инлайновые (React style=)
			# + Google Fonts; картинки/медиа https (обложки событий и подкастов —
			# внешние URL из админки); объекты и чужие base/form запрещены.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org 'self'"
			# Ненужные сайту браузерные API выключены явно; версию сервера не светим
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
			-Server
		}
		reverse_proxy web:80
	}
}

{$ADMIN_DOMAIN} {
	encode gzip
	header {
		# Заголовки безопасности и на Studio-домене (раньше их не было вовсе).
		# CSP тут НЕ задаём: Directus присылает собственную политику для админки.
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
	reverse_proxy directus:8055
}
