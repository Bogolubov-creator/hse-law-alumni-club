{
	email {$ACME_EMAIL}
	servers {
		timeouts {
			read_body 300s
			read_header 5s
			idle 60s
		}
		max_header_size 16kb
	}
}

{$WEB_DOMAIN} {
	encode gzip
	@avatar_upload path /api/me/avatar
	request_body @avatar_upload {
		max_size 4MB
	}
	@office_upload path /api/admin/media
	request_body @office_upload {
		max_size 129MB
	}
	@regular_request not path /api/me/avatar /api/admin/media
	request_body @regular_request {
		max_size 512kb
	}
	@bot_probe path /wp-admin* /wp-login.php /.env /.env.* /.git/* /xmlrpc.php /phpmyadmin* /vendor/* /.aws/* /config.php
	handle @bot_probe {
		respond 404
	}
	@legacy_asset path_regexp legacy_asset ^/assets/[0-9a-fA-F-]{36}(/.*)?$
	handle @legacy_asset {
		uri replace /assets/ /media/
		reverse_proxy api:3000
	}
	handle_path /api/* {
		reverse_proxy api:3000
	}
	handle /sitemap.xml {
		rewrite * /sitemap.xml
		reverse_proxy api:3000
	}
	handle /robots.txt {
		rewrite * /robots.txt
		reverse_proxy api:3000
	}
	handle {
		header {
			Strict-Transport-Security "max-age=15552000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; media-src 'self' https: blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-src https://rutube.ru https://www.rutube.ru; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org 'self'"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
			-Server
		}
		reverse_proxy web:80
	}
}

{$ADMIN_DOMAIN} {
	handle /assets/* {
		uri replace /assets/ /media/
		reverse_proxy api:3000
	}
	handle {
		redir {$PUBLIC_URL}/admin 308
	}
}
