:80 {
	root * /srv
	encode gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; media-src 'self' https: blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-src https://rutube.ru https://www.rutube.ru; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org 'self'"
		-Server
	}

	@assets path /assets/* *.js *.css *.png *.jpg *.jpeg *.webp *.svg *.woff2
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@service path /sw.js /manifest.webmanifest
	header @service Cache-Control "no-cache"

	@spa path / /v2 /v2/dpo /v2/dpo/* /v2/merch /v2/cart /v2/news /v2/news/* /v2/events /v2/podcasts /v2/join /v2/forgot /v2/reset /v2/confirm /v2/privacy /v2/confidential /v2/requisites /v2/lk /v2/lk/profile /news /news/* /dpo /dpo/* /merch /podcasts /events /cart /join /forgot /reset /confirm /privacy /confidential /requisites /lk /lk/* /admin /admin/*
	handle @spa {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	handle {
		@exists file {path}
		handle @exists {
			file_server
		}
		handle {
			header Cache-Control "no-cache"
			rewrite * /index.html
			file_server {
				status 404
			}
		}
	}
}
