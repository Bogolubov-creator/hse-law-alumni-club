{
  "name": "club-pravo-hse",
  "version": "0.0.0",
  "private": true,
  "description": "Клуб выпускников факультета права НИУ ВШЭ — монорепо (web + api + directus)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @club/api dev",
    "dev:web": "pnpm --filter @club/web dev",
    "bootstrap": "pnpm --filter @club/scripts bootstrap",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "lint": "eslint apps/api/src apps/web/src packages/shared/src scripts/src"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.71.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.7",
      "find-my-way": "^9.7.0",
      "uuid": "^11.1.1"
    }
  }
}
