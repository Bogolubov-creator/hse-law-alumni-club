{
  "name": "club-pravo-hse",
  "version": "0.0.0",
  "private": true,
  "description": "Клуб выпускников факультета права НИУ ВШЭ — монорепо (web + api + directus)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @club/api dev",
    "dev:web": "pnpm --filter @club/web dev",
    "bootstrap": "pnpm --filter @club/scripts bootstrap",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
