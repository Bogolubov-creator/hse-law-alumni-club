{
  "name": "club-pravo-hse",
  "version": "0.0.0",
  "private": true,
  "description": "Клуб выпускников факультета права НИУ ВШЭ – React, FastAPI и PostgreSQL",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "uv run --directory backend python -m club_api.main",
    "dev:web": "pnpm --filter @club/web dev",
    "bootstrap": "uv run --directory scripts club-ops bootstrap",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "lint": "eslint frontend/src frontend/tests/unit packages && uv run --directory backend ruff check club_api tests/python ../scripts/club_ops"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
