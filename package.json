{
  "name": "club-pravo-hse",
  "version": "0.0.0",
  "private": true,
  "description": "Клуб выпускников факультета права НИУ ВШЭ – React, Fastify и PostgreSQL",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @club/api dev",
    "dev:web": "pnpm --filter @club/web dev",
    "bootstrap": "pnpm --filter @club/scripts bootstrap",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "lint": "eslint backend/src frontend/src packages scripts/src"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
