:80 {
	root * /srv
	encode gzip
	# Хешированные ассеты Vite (имя меняется при сборке) – кэш на год.
	@assets path /assets/* *.js *.css *.png *.jpg *.jpeg *.webp *.svg *.woff2
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Служебные файлы не кэшируем жёстко – чтобы релиз доезжал сразу.
	@service path /sw.js /manifest.webmanifest
	header @service Cache-Control "no-cache"

	# Известные маршруты SPA отдаём оболочкой с кодом 200. Всё остальное –
	# та же оболочка (React покажет «Страница не найдена»), но со статусом 404:
	# иначе любой несуществующий адрес отвечал 200, и поисковики считали его
	# полноценной страницей (soft-404 и мусор в индексе).
	@spa path / /v2 /v2/* /news /news/* /dpo /dpo/* /merch /podcasts /events /cart /join /forgot /reset /confirm /privacy /confidential /requisites /lk /lk/* /admin /admin/*
	handle @spa {
		# no-cache на ВСЕХ адресах оболочки, а не только на «/». Раньше заголовок
		# стоял лишь для / и /index.html, поэтому у зашедшего по прямой ссылке
		# (/merch, /dpo, /cart) оболочка кэшировалась эвристикой браузера – после
		# релиза он продолжал грузить старый бандл по старому хешу.
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	handle {
		# Существующий файл (ассет, картинка, sw.js) отдаём как есть…
		@exists file {path}
		handle @exists {
			file_server
		}
		# …а неизвестный адрес – оболочкой с честным 404.
		handle {
			header Cache-Control "no-cache"
			rewrite * /index.html
			file_server {
				status 404
			}
		}
	}
}
